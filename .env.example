# Copy to .env.local and fill in what you need. Every variable is optional for
# local development; features that depend on a missing value degrade gracefully.
# In production these are Cloudflare Worker secrets (see README → Deployment).

# ACLED account credentials (https://acleddata.com/user/register).
# Used by /api/cache/refresh, ACLED enrichment in /api/battles,
# scripts/prebuild-events.ts and `npm run cache:warm`. Without them the
# bundled ACLED snapshot is served.
ACLED_EMAIL=
ACLED_PASSWORD=

# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# Needed for the thermal anomaly layer; the DEMO_KEY fallback rarely returns data.
NASA_FIRMS_KEY=

# ENTSO-E Transparency Platform API token, used by the Energy panel.
ENTSOE_TOKEN=

# Bearer token for the POST /api/cache/* maintenance routes. Must match the
# secret configured on the data-refresh cron worker and in GitHub Actions.
CACHE_REFRESH_SECRET=

# Cloudflare credentials for POST /api/cache/purge (CDN purge).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare Web Analytics beacon token, read at build time.
CF_WEB_ANALYTICS_TOKEN=
