{
  "name": "ukrainewar",
  "version": "1.4.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/prebuild-viina.ts && tsx scripts/prebuild-alliance.ts && tsx scripts/prebuild-territory-dates.ts && next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cron": "cd workers/data-refresh && npx wrangler deploy --config wrangler.toml",
    "data:kiel": "tsx scripts/prebuild-spending.ts",
    "data:validate": "tsx scripts/validate-spending-data.ts",
    "data:acled": "node scripts/process-acled-hdx.mjs",
    "data:viina": "node scripts/process-viina.mjs",
    "data:update": "npm run data:kiel && node scripts/process-acled-hdx.mjs && node scripts/process-viina.mjs",
    "data:events": "tsx scripts/update-events-gc.ts",
    "cache:warm": "node scripts/warm-cache.mjs",
    "prepare": "husky; node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "maplibre-gl": "6.6.0",
    "next": "16.3.3",
    "nuqs": "^2.10.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@opennextjs/cloudflare": "1.20.5",
    "@tailwindcss/postcss": "4.3.3",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "tailwindcss": "4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "world-atlas": "^2.0.2",
    "wrangler": "4.127.1"
  },
  "license": "AGPL-3.0-or-later",
  "author": "David Engel (https://github.com/engelde)",
  "repository": {
    "type": "git",
    "url": "https://github.com/engelde/ukrainewar.git"
  },
  "homepage": "https://ukrainewar.app"
}
