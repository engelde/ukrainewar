{
  "name": "ukrainewar",
  "version": "1.4.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run data:prebuild && next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cron": "cd workers/data-refresh && npx wrangler deploy --config wrangler.toml",
    "data:prebuild": "tsx scripts/prebuild-viina.ts && tsx scripts/prebuild-alliance.ts && tsx scripts/prebuild-territory-dates.ts",
    "data:kiel": "tsx scripts/prebuild-spending.ts",
    "data:validate": "tsx scripts/validate-spending-data.ts",
    "data:acled": "node scripts/process-acled-hdx.mjs",
    "data:viina": "node scripts/process-viina.mjs",
    "data:update": "npm run data:kiel && node scripts/process-acled-hdx.mjs && node scripts/process-viina.mjs",
    "data:events": "tsx scripts/update-events-gc.ts",
    "cache:warm": "node scripts/warm-cache.mjs",
    "prepare": "husky; node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "shadcn": "4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@opennextjs/cloudflare": "1.20.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^14.0.3"
    },
    "@opennextjs/cloudflare": {
      "glob": "^14.0.3"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.3"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "license": "AGPL-3.0-or-later",
  "author": "David Engel (https://github.com/engelde)",
  "repository": {
    "type": "git",
    "url": "https://github.com/engelde/ukrainewar.git"
  },
  "homepage": "https://ukrainewar.app"
}
